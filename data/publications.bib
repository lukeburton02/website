% Publications, in BibTeX. Currently empty.
%
% research.qmd sets `bibliography: data/publications.bib` with `nocite: "@*"`,
% so every entry added here appears automatically in the Publications list —
% no edit to any .qmd file is needed.
%
% Expected format (uncomment and edit, or paste exports from Zotero/Scholar):
%
% @article{lastname2025descriptor,
%   author  = {Lastname, Firstname and Coauthor, Another},
%   title   = {The Title of the Article},
%   journal = {Journal Name},
%   year    = {2025},
%   volume  = {12},
%   number  = {3},
%   pages   = {45--67},
%   doi     = {10.1000/placeholder},
% }
%
% @incollection{lastname2024chapter,
%   author    = {Lastname, Firstname},
%   title     = {The Title of the Chapter},
%   booktitle = {The Title of the Edited Volume},
%   editor    = {Editor, Some},
%   publisher = {Publisher Name},
%   address   = {City},
%   year      = {2024},
%   pages     = {101--120},
% }
%
% @unpublished{lastname2025preprint,
%   author = {Lastname, Firstname},
%   title  = {The Title of the Working Paper},
%   note   = {Preprint},
%   year   = {2025},
%   url    = {https://example.com/preprint},
% }
% ---------------------------------------------------------------------------
